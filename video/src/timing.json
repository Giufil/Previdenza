{
 "duration": 43.922333333333334,
 "lines": [
  {
   "scene": "hook",
   "s": 0.0,
   "e": 3.468,
   "text": "Nonno Franco regala 5.000 euro a Sofia, appena nata."
  },
  {
   "scene": "hook",
   "s": 3.628,
   "e": 4.486,
   "text": "Dove li mette?"
  },
  {
   "scene": "bfp",
   "s": 4.786,
   "e": 7.847,
   "text": "Strada uno: buono fruttifero postale per minori."
  },
  {
   "scene": "bfp",
   "s": 8.007,
   "e": 11.375,
   "text": "Garantito, rende circa il 4% lordo l'anno."
  },
  {
   "scene": "bfp18",
   "s": 11.675,
   "e": 15.207,
   "text": "A 18 anni: circa 9.500 euro netti."
  },
  {
   "scene": "bfp18",
   "s": 15.367,
   "e": 16.972,
   "text": "E lì gli interessi si fermano."
  },
  {
   "scene": "msci",
   "s": 17.272,
   "e": 20.495,
   "text": "Strada due: un ETF sull'indice MSCI World,"
  },
  {
   "scene": "msci",
   "s": 20.655,
   "e": 22.668,
   "text": "oltre mille aziende in tutto il mondo."
  },
  {
   "scene": "vs18",
   "s": 22.968,
   "e": 27.403,
   "text": "Al 7% medio annuo, a 18 anni sono circa 13.000 euro,"
  },
  {
   "scene": "vs18",
   "s": 27.563,
   "e": 29.141,
   "text": "già netti di costi e tasse."
  },
  {
   "scene": "vs30",
   "s": 29.441,
   "e": 32.096,
   "text": "E se non le servono? Restano investiti:"
  },
  {
   "scene": "vs30",
   "s": 32.256,
   "e": 34.644,
   "text": "a 30 anni, oltre 26.000 euro."
  },
  {
   "scene": "cta",
   "s": 34.944,
   "e": 37.676,
   "text": "Ci saranno anni di crollo, serve pazienza."
  },
  {
   "scene": "cta",
   "s": 37.836,
   "e": 39.821,
   "text": "Ma il tempo è il regalo più prezioso."
  },
  {
   "scene": "cta",
   "s": 39.981,
   "e": 41.722,
   "text": "Giralo a chi ha un bimbo in arrivo!"
  }
 ],
